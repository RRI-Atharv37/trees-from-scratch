# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/

# Secrets / logs
.env
.env.*
!.env.example
*.log

# Notebooks
.ipynb_checkpoints/

# Data / artifacts (only data/README.md and the .gitkeep placeholders are tracked)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/**/*.part
data/**/*.zip
artifacts/
checkpoints/
runs/
lightning_logs/
wandb/
mlruns/

# Serialized models / array dumps (large or regenerable)
*.pkl
*.pickle
*.pkz
*.joblib
*.npz
*.npy
*.parquet
*.feather

# CSVs are ignored everywhere (datasets, scratch exports) EXCEPT the small result
# tables in reports/, which the README links to and which are regenerated by scripts/.
*.csv
!reports/*.csv

# Graphviz intermediates (small_tree.png is rendered by matplotlib and IS committed)
reports/figures/*.dot
reports/figures/*.gv

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
